{
  "name": "org-wide-main-protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH", "refs/heads/staging"],
      "exclude": []
    },
    "repository_name": {
      "include": ["~ALL"],
      "exclude": ["sandbox-*", "archive-*"],
      "protected": false
    }
  },
  "bypass_actors": [
    {
      "actor_id": 1,
      "actor_type": "OrganizationAdmin",
      "bypass_mode": "always"
    }
  ],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "require_extra_approval_for_unattributed_changes": false,
        "required_reviewers": [],
        "allowed_merge_methods": ["squash", "rebase"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "lint / actionlint"
          },
          {
            "context": "lint / JSON validity"
          },
          {
            "context": "lint / prettier"
          },
          {
            "context": "lint / markdownlint"
          },
          {
            "context": "lint / yamllint"
          }
        ]
      }
    },
    {
      "type": "workflows",
      "parameters": {
        "do_not_enforce_on_create": false,
        "workflows": [
          {
            "repository_id": 1211111495,
            "path": ".github/workflows/org-lint.yml",
            "ref": "refs/heads/main"
          },
          {
            "repository_id": 1211111495,
            "path": ".github/workflows/release-version-check.yml",
            "ref": "refs/heads/main"
          },
          {
            "repository_id": 1211111495,
            "path": ".github/workflows/repo-standards.yml",
            "ref": "refs/heads/main"
          }
        ]
      }
    }
  ]
}
