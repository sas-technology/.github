# EditorConfig — https://editorconfig.org
# Keeps whitespace consistent across editors before Prettier,
# SwiftFormat, or a Python formatter gets a chance to run.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
# Markdown: trailing spaces are significant (hard line-break).
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.py]
indent_size = 4

[*.swift]
indent_size = 4

[Makefile]
indent_style = tab
